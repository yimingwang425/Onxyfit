<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        UserProfile: declared allergens (comma-separated Allergen codes) and free-text foods to avoid.
    -->
    <changeSet id="20261007010000-1" author="yxw1268">
        <addColumn tableName="user_profile">
            <column name="allergies" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="food_dislikes" type="varchar(500)">
                <constraints nullable="true" />
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
